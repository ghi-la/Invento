# --- MongoDB Atlas ---
# Replace <db_username> and <db_password> with your Atlas database user credentials.
# Make sure the user has readWrite access and your IP / 0.0.0.0/0 is allowed in Network Access.
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster-ghila.zrsoj.mongodb.net/warehouse_inventory?retryWrites=true&w=majority&appName=Cluster-Ghila"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=set-your-own-secret-key-here
# Local dev: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (optional but recommended) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
